  "bugs": {
    "url": "https://github.com/evdorfman/production/issues"
  },
  "homepage": "https://github.com/evdorfman/production#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "vitest": "^5.0.5"
  }
}
